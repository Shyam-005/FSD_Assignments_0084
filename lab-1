<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cordillera Roasting Co. — Coffee from the Ranges</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,500;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#15181a;
    --panel:#1f2320;
    --panel-2:#262b27;
    --line: rgba(237,234,226,0.12);
    --text:#EDEAE2;
    --text-muted:#9a9488;
    --sage:#8fa06a;
    --sage-dim: rgba(143,160,106,0.18);
    --gold:#c9a227;
    --rust:#a64b2a;
    --radius: 10px;
    --maxw: 1120px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:'Work Sans', sans-serif;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    *{animation-duration:0.001ms !important; transition-duration:0.001ms !important;}
  }
  h1,h2,h3{
    font-family:'Fraunces', serif;
    font-weight:600;
    margin:0;
    letter-spacing:-0.01em;
  }
  .mono{ font-family:'IBM Plex Mono', monospace; letter-spacing:0.02em; }
  a{ color:inherit; }
  .wrap{ max-width:var(--maxw); margin:0 auto; padding:0 24px; }
  img, svg{ display:block; max-width:100%; }

  a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible, [tabindex]:focus-visible{
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }

  /* ---------- NAV ---------- */
  header{
    position:sticky; top:0; z-index:50;
    background:rgba(21,24,26,0.88);
    backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);
  }
  nav{
    display:flex; align-items:center; justify-content:space-between;
    padding:18px 24px;
    max-width:var(--maxw); margin:0 auto;
  }
  .logo{
    font-family:'Fraunces', serif; font-weight:700; font-size:1.15rem;
    letter-spacing:0.02em; text-decoration:none; color:var(--text);
    display:flex; align-items:center; gap:10px;
  }
  .logo .mark{ width:20px; height:20px; }
  .nav-links{
    display:flex; gap:32px; list-style:none; margin:0; padding:0;
  }
  .nav-links a{
    text-decoration:none; font-size:0.92rem; color:var(--text-muted);
    transition:color 0.2s ease;
  }
  .nav-links a:hover{ color:var(--sage); }
  .nav-toggle{
    display:none; background:none; border:1px solid var(--line);
    border-radius:8px; width:40px; height:40px; cursor:pointer;
    color:var(--text); flex-direction:column; align-items:center; justify-content:center; gap:4px;
  }
  .nav-toggle span{ width:18px; height:1.5px; background:var(--text); display:block; }

  @media (max-width: 780px){
    .nav-links{
      position:absolute; top:100%; left:0; right:0;
      flex-direction:column; gap:0;
      background:var(--panel);
      border-bottom:1px solid var(--line);
      max-height:0; overflow:hidden;
      transition: max-height 0.3s ease;
    }
    .nav-links.open{ max-height:280px; }
    .nav-links a{
      padding:16px 24px; border-bottom:1px solid var(--line); width:100%;
    }
    .nav-toggle{ display:flex; }
  }

  /* ---------- HERO ---------- */
  .hero{
    padding:96px 0 72px;
    border-bottom:1px solid var(--line);
  }
  .eyebrow{
    color:var(--sage); font-size:0.8rem; text-transform:uppercase;
    display:flex; align-items:center; gap:10px; margin-bottom:22px;
  }
  .eyebrow::before{
    content:''; width:22px; height:1px; background:var(--sage);
  }
  .hero h1{
    font-size:clamp(2.4rem, 5.6vw, 4.4rem);
    line-height:1.04;
    max-width:15ch;
  }
  .hero h1 em{
    font-style:italic; color:var(--sage); font-weight:500;
  }
  .hero-sub{
    max-width:46ch; color:var(--text-muted); font-size:1.05rem;
    margin-top:26px;
  }
  .hero-actions{ display:flex; gap:16px; margin-top:36px; flex-wrap:wrap; }
  .btn{
    padding:13px 26px; border-radius:8px; font-size:0.92rem; font-weight:500;
    text-decoration:none; cursor:pointer; border:1px solid transparent;
    transition: transform 0.15s ease, background 0.2s ease;
    display:inline-block;
  }
  .btn-primary{ background:var(--sage); color:#14170f; }
  .btn-primary:hover{ transform:translateY(-1px); }
  .btn-ghost{ border-color:var(--line); background:transparent; color:var(--text); }
  .btn-ghost:hover{ border-color:var(--sage); color:var(--sage); }

  .hero-stats{
    display:grid; grid-template-columns:repeat(3,1fr); gap:1px;
    background:var(--line); margin-top:64px; border:1px solid var(--line); border-radius:var(--radius); overflow:hidden;
  }
  .hero-stats div{ background:var(--panel); padding:20px 22px; }
  .hero-stats .num{ font-family:'Fraunces', serif; font-size:1.7rem; color:var(--gold); }
  .hero-stats .label{ font-size:0.78rem; color:var(--text-muted); margin-top:4px; }

  @media (max-width:600px){
    .hero-stats{ grid-template-columns:1fr; }
  }

  /* ---------- SECTION shared ---------- */
  section{ padding:88px 0; border-bottom:1px solid var(--line); }
  .section-head{ margin-bottom:48px; max-width:60ch; }
  .section-head .eyebrow{ margin-bottom:14px; }
  .section-head h2{ font-size:clamp(1.8rem, 3.4vw, 2.6rem); }
  .section-head p{ color:var(--text-muted); margin-top:14px; }

  /* ---------- ORIGINS ---------- */
  .origin-grid{
    display:grid; grid-template-columns:repeat(3, 1fr); gap:20px;
  }
  @media (max-width:900px){ .origin-grid{ grid-template-columns:1fr; } }
  .origin-card{
    background:var(--panel); border:1px solid var(--line); border-radius:var(--radius);
    padding:28px; position:relative; overflow:hidden;
  }
  .origin-card .alt{
    position:absolute; top:24px; right:24px; text-align:right;
    font-size:0.72rem; color:var(--text-muted);
  }
  .origin-card .alt strong{ display:block; font-size:1.1rem; color:var(--gold); font-family:'Fraunces',serif; }
  .origin-card h3{ font-size:1.3rem; margin-top:8px; max-width:70%; }
  .origin-card .place{ color:var(--sage); font-size:0.85rem; margin-top:6px; }
  .origin-card p{ color:var(--text-muted); font-size:0.92rem; margin-top:16px; }
  .tag-row{ display:flex; gap:8px; margin-top:18px; flex-wrap:wrap; }
  .tag{
    font-size:0.72rem; padding:5px 10px; border-radius:20px;
    background:var(--sage-dim); color:var(--sage); border:1px solid rgba(143,160,106,0.3);
  }

  /* ---------- ROAST SLIDER (signature) ---------- */
  .roast-panel{
    background:var(--panel); border:1px solid var(--line); border-radius:var(--radius);
    padding:40px;
    display:grid; grid-template-columns:1fr 1.2fr; gap:48px; align-items:center;
  }
  @media (max-width:820px){ .roast-panel{ grid-template-columns:1fr; padding:28px; gap:32px; } }

  .bean-stage{ display:flex; flex-direction:column; align-items:center; gap:18px; }
  .bean-stage svg{ width:180px; height:180px; }
  #beanFill{ transition: fill 0.25s ease; }
  #beanFill2{ transition: fill 0.25s ease; }
  .stage-label{
    font-family:'Fraunces', serif; font-size:1.3rem; text-align:center;
    transition: color 0.25s ease;
  }
  .stage-time{ color:var(--text-muted); font-size:0.85rem; }

  .roast-controls label{
    font-size:0.78rem; text-transform:uppercase; color:var(--text-muted); display:block; margin-bottom:14px;
  }
  input[type="range"]{
    width:100%; -webkit-appearance:none; appearance:none;
    height:4px; border-radius:4px; background:var(--line); outline:none; margin-bottom:8px;
  }
  input[type="range"]::-webkit-slider-thumb{
    -webkit-appearance:none; appearance:none;
    width:20px; height:20px; border-radius:50%;
    background:var(--gold); border:3px solid var(--bg); cursor:pointer;
    box-shadow:0 0 0 1px var(--gold);
  }
  input[type="range"]::-moz-range-thumb{
    width:20px; height:20px; border-radius:50%;
    background:var(--gold); border:3px solid var(--bg); cursor:pointer;
  }
  .roast-ticks{
    display:flex; justify-content:space-between; font-size:0.7rem; color:var(--text-muted); margin-bottom:28px;
  }
  .roast-notes{
    background:var(--panel-2); border-radius:8px; padding:20px 22px; min-height:96px;
  }
  .roast-notes .flavor{ font-family:'Fraunces', serif; font-size:1.15rem; margin-bottom:6px; transition:color 0.2s ease; }
  .roast-notes p{ margin:0; color:var(--text-muted); font-size:0.88rem; }

  /* ---------- BREW TABS ---------- */
  .tabs{ display:flex; gap:8px; margin-bottom:32px; flex-wrap:wrap; }
  .tab-btn{
    background:var(--panel); border:1px solid var(--line); color:var(--text-muted);
    padding:11px 20px; border-radius:8px; cursor:pointer; font-size:0.88rem; font-family:inherit;
    transition:all 0.2s ease;
  }
  .tab-btn[aria-selected="true"]{
    background:var(--sage-dim); border-color:var(--sage); color:var(--sage);
  }
  .tab-panel{ display:none; }
  .tab-panel.active{ display:grid; grid-template-columns:1fr 1fr; gap:40px; }
  @media (max-width:800px){ .tab-panel.active{ grid-template-columns:1fr; } }
  .brew-steps{ list-style:none; margin:0; padding:0; counter-reset:step; }
  .brew-steps li{
    counter-increment:step; padding:16px 0 16px 44px; position:relative;
    border-bottom:1px solid var(--line); font-size:0.94rem;
  }
  .brew-steps li:last-child{ border-bottom:none; }
  .brew-steps li::before{
    content:counter(step); position:absolute; left:0; top:14px;
    font-family:'IBM Plex Mono', monospace; color:var(--gold); font-size:0.85rem;
  }
  .brew-specs{ background:var(--panel); border:1px solid var(--line); border-radius:var(--radius); padding:28px; align-self:start; }
  .brew-specs .spec-row{
    display:flex; justify-content:space-between; padding:10px 0; border-bottom:1px solid var(--line); font-size:0.88rem;
  }
  .brew-specs .spec-row:last-child{ border-bottom:none; }
  .brew-specs .spec-row span:first-child{ color:var(--text-muted); }
  .brew-specs .spec-row span:last-child{ font-family:'IBM Plex Mono', monospace; color:var(--gold); }

  /* ---------- VISIT / FORM ---------- */
  .visit-grid{ display:grid; grid-template-columns:1fr 1fr; gap:56px; }
  @media (max-width:800px){ .visit-grid{ grid-template-columns:1fr; } }
  .hours-list{ list-style:none; padding:0; margin:24px 0 0; }
  .hours-list li{
    display:flex; justify-content:space-between; padding:10px 0; border-bottom:1px solid var(--line); font-size:0.92rem;
  }
  .hours-list li span:last-child{ color:var(--text-muted); font-family:'IBM Plex Mono', monospace; font-size:0.85rem; }

  form{ display:flex; flex-direction:column; gap:16px; }
  .field label{ display:block; font-size:0.78rem; text-transform:uppercase; color:var(--text-muted); margin-bottom:8px; }
  .field input, .field textarea{
    width:100%; background:var(--panel); border:1px solid var(--line); border-radius:8px;
    padding:12px 14px; color:var(--text); font-family:inherit; font-size:0.94rem;
  }
  .field textarea{ resize:vertical; min-height:90px; }
  .field .err{ color:var(--rust); font-size:0.78rem; margin-top:6px; display:none; }
  .field.invalid input, .field.invalid textarea{ border-color:var(--rust); }
  .field.invalid .err{ display:block; }
  .form-status{
    font-size:0.88rem; padding:12px 14px; border-radius:8px; display:none; margin-top:4px;
  }
  .form-status.show{ display:block; }
  .form-status.ok{ background:var(--sage-dim); color:var(--sage); }

  footer{ padding:40px 0; }
  footer .wrap{ display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; }
  footer .mono{ color:var(--text-muted); font-size:0.78rem; }
</style>
</head>
<body>

<header>
  <nav>
    <a href="#top" class="logo">
      <svg class="mark" viewBox="0 0 24 24" fill="none"><path d="M12 2 L20 20 L4 20 Z" stroke="#c9a227" stroke-width="1.4"/><path d="M12 8 L16 20 L8 20 Z" fill="#8fa06a" opacity="0.8"/></svg>
      CORDILLERA
    </a>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <ul class="nav-links" id="navLinks">
      <li><a href="#origins">Origins</a></li>
      <li><a href="#roast">Roast</a></li>
      <li><a href="#brew">Brew</a></li>
      <li><a href="#visit">Visit</a></li>
    </ul>
  </nav>
</header>

<main id="top">

  <section class="hero">
    <div class="wrap">
      <div class="eyebrow mono">Roasted at 340m · Small batch</div>
      <h1>Coffee carried down from <em>the ranges</em>.</h1>
      <p class="hero-sub">We buy in whole lots from three mountain regions, roast in batches under twelve kilos, and ship within a week of the drop. Nothing sits in a warehouse.</p>
      <div class="hero-actions">
        <a href="#origins" class="btn btn-primary">See this week's origins</a>
        <a href="#roast" class="btn btn-ghost">Explore a roast curve</a>
      </div>
      <div class="hero-stats">
        <div><div class="num">3</div><div class="label">Active origins this season</div></div>
        <div><div class="num">11 kg</div><div class="label">Average batch size</div></div>
        <div><div class="num">≤ 7 days</div><div class="label">Roast to shipment</div></div>
      </div>
    </div>
  </section>

  <section id="origins">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow mono">Origins</div>
        <h2>Three lots, one season.</h2>
        <p>Each origin is bought direct from the mill and listed with the altitude it grew at — the single number that tells you the most about how it'll taste.</p>
      </div>
      <div class="origin-grid">
        <div class="origin-card">
          <div class="alt mono">ALT<strong>1,950m</strong></div>
          <h3>Yirgacheffe</h3>
          <div class="place mono">Ethiopia · Gedeo Zone</div>
          <p>Washed, dried on raised beds. Bright and floral with a jasmine tea character that fades to stone fruit as it cools.</p>
          <div class="tag-row"><span class="tag">Washed</span><span class="tag">Floral</span><span class="tag">Light roast</span></div>
        </div>
        <div class="origin-card">
          <div class="alt mono">ALT<strong>1,700m</strong></div>
          <h3>Huila</h3>
          <div class="place mono">Colombia · Pitalito</div>
          <p>Honey-processed, full body with red apple acidity and a brown-sugar finish. Holds up well in milk.</p>
          <div class="tag-row"><span class="tag">Honey</span><span class="tag">Caramel</span><span class="tag">Medium roast</span></div>
        </div>
        <div class="origin-card">
          <div class="alt mono">ALT<strong>1,550m</strong></div>
          <h3>Antigua</h3>
          <div class="place mono">Guatemala · Sacatepéquez</div>
          <p>Grown in volcanic soil beneath three peaks. Smoky cacao, walnut, and a long, dry finish.</p>
          <div class="tag-row"><span class="tag">Natural</span><span class="tag">Cocoa</span><span class="tag">Dark roast</span></div>
        </div>
      </div>
    </div>
  </section>

  <section id="roast">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow mono">The roast curve</div>
        <h2>Drag through a roast.</h2>
        <p>Every bean moves through the same stages on the way from green to dark. Slide through the curve to see what's happening inside the drum at each minute.</p>
      </div>

      <div class="roast-panel">
        <div class="bean-stage">
          <svg viewBox="0 0 100 100" aria-hidden="true">
            <ellipse id="beanFill" cx="50" cy="50" rx="34" ry="44" fill="#7a9b3f" transform="rotate(-12 50 50)"/>
            <path id="beanFill2" d="M50 12 Q46 50 50 88" stroke="#4a5f26" stroke-width="3" fill="none" transform="rotate(-12 50 50)"/>
          </svg>
          <div class="stage-label" id="stageLabel">Green</div>
          <div class="stage-time mono" id="stageTime">0:00 in the drum</div>
        </div>

        <div class="roast-controls">
          <label for="roastSlider">Roast time</label>
          <input type="range" id="roastSlider" min="0" max="100" value="0" aria-describedby="stageLabel">
          <div class="roast-ticks mono">
            <span>Drop</span><span>Yellowing</span><span>1st Crack</span><span>2nd Crack</span><span>Charred</span>
          </div>
          <div class="roast-notes">
            <div class="flavor" id="flavorTitle">Grassy, dense, unroasted</div>
            <p id="flavorDesc">The bean is still green and hard. No aroma to speak of yet — this is just raw seed.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="brew">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow mono">Brew guides</div>
        <h2>How we'd make it at home.</h2>
        <p>Ratios we've settled on after a lot of wasted coffee. Start here, then adjust to taste.</p>
      </div>

      <div class="tabs" role="tablist" aria-label="Brew method">
        <button class="tab-btn" role="tab" aria-selected="true" aria-controls="panel-pour" id="tab-pour">Pour Over</button>
        <button class="tab-btn" role="tab" aria-selected="false" aria-controls="panel-press" id="tab-press">French Press</button>
        <button class="tab-btn" role="tab" aria-selected="false" aria-controls="panel-espresso" id="tab-espresso">Espresso</button>
      </div>

      <div class="tab-panel active" id="panel-pour" role="tabpanel" aria-labelledby="tab-pour">
        <ol class="brew-steps">
          <li>Rinse the filter with hot water, then discard the rinse water.</li>
          <li>Add grounds and level the bed with a gentle shake.</li>
          <li>Bloom with double the water weight in grounds, wait 45 seconds.</li>
          <li>Pour the remaining water in slow circles over 2–3 minutes.</li>
          <li>Let it fully drain before removing the filter.</li>
        </ol>
        <div class="brew-specs">
          <div class="spec-row"><span>Ratio</span><span>1:16</span></div>
          <div class="spec-row"><span>Grind</span><span>Medium</span></div>
          <div class="spec-row"><span>Water temp</span><span>94°C</span></div>
          <div class="spec-row"><span>Total time</span><span>3:00</span></div>
        </div>
      </div>

      <div class="tab-panel" id="panel-press" role="tabpanel" aria-labelledby="tab-press">
        <ol class="brew-steps">
          <li>Add coarse grounds to the empty press.</li>
          <li>Pour all the water at once, fully saturating the grounds.</li>
          <li>Stir once, then place the lid on without plunging.</li>
          <li>Steep for four minutes.</li>
          <li>Plunge slowly and pour immediately to stop extraction.</li>
        </ol>
        <div class="brew-specs">
          <div class="spec-row"><span>Ratio</span><span>1:15</span></div>
          <div class="spec-row"><span>Grind</span><span>Coarse</span></div>
          <div class="spec-row"><span>Water temp</span><span>96°C</span></div>
          <div class="spec-row"><span>Total time</span><span>4:00</span></div>
        </div>
      </div>

      <div class="tab-panel" id="panel-espresso" role="tabpanel" aria-labelledby="tab-espresso">
        <ol class="brew-steps">
          <li>Dose into the portafilter and distribute evenly.</li>
          <li>Tamp level with firm, consistent pressure.</li>
          <li>Lock in and start the shot immediately.</li>
          <li>Target 25–30 seconds from first drip to full yield.</li>
          <li>Stop the shot once yield weight is reached, taste, adjust grind.</li>
        </ol>
        <div class="brew-specs">
          <div class="spec-row"><span>Ratio</span><span>1:2</span></div>
          <div class="spec-row"><span>Grind</span><span>Fine</span></div>
          <div class="spec-row"><span>Water temp</span><span>93°C</span></div>
          <div class="spec-row"><span>Total time</span><span>0:28</span></div>
        </div>
      </div>
    </div>
  </section>

  <section id="visit">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow mono">Visit</div>
        <h2>Come cup with us.</h2>
        <p>Public cuppings run every Saturday morning — no booking needed, just show up before 10.</p>
      </div>

      <div class="visit-grid">
        <div>
          <ul class="hours-list">
            <li><span>Monday – Friday</span><span>7:00 – 17:00</span></li>
            <li><span>Saturday</span><span>8:00 – 15:00</span></li>
            <li><span>Sunday</span><span>Closed</span></li>
          </ul>
          <p style="color:var(--text-muted); font-size:0.92rem; margin-top:20px;">14 Foundry Lane, roastery entrance around the back.</p>
        </div>

        <form id="contactForm" novalidate>
          <div class="field" id="field-name">
            <label for="name">Name</label>
            <input type="text" id="name" name="name">
            <div class="err">Tell us who's asking.</div>
          </div>
          <div class="field" id="field-email">
            <label for="email">Email</label>
            <input type="email" id="email" name="email">
            <div class="err">That email doesn't look right.</div>
          </div>
          <div class="field" id="field-message">
            <label for="message">Message</label>
            <textarea id="message" name="message"></textarea>
            <div class="err">Give us a line or two.</div>
          </div>
          <button type="submit" class="btn btn-primary">Send message</button>
          <div class="form-status" id="formStatus"></div>
        </form>
      </div>
    </div>
  </section>

</main>

<footer>
  <div class="wrap">
    <span class="logo" style="font-size:0.95rem;">CORDILLERA</span>
    <span class="mono">© 2026 Cordillera Roasting Co.</span>
  </div>
</footer>

<script>
  // Mobile nav toggle
  const navToggle = document.getElementById('navToggle');
  const navLinks = document.getElementById('navLinks');
  navToggle.addEventListener('click', () => {
    const open = navLinks.classList.toggle('open');
    navToggle.setAttribute('aria-expanded', open);
  });
  navLinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    navLinks.classList.remove('open');
    navToggle.setAttribute('aria-expanded', 'false');
  }));

  // Roast slider (signature interactive element)
  const slider = document.getElementById('roastSlider');
  const beanFill = document.getElementById('beanFill');
  const beanFill2 = document.getElementById('beanFill2');
  const stageLabel = document.getElementById('stageLabel');
  const stageTime = document.getElementById('stageTime');
  const flavorTitle = document.getElementById('flavorTitle');
  const flavorDesc = document.getElementById('flavorDesc');

  const stops = [
    { pos:0,  time:'0:00', color:'#7a9b3f', line:'#4a5f26', label:'Green',
      title:'Grassy, dense, unroasted',
      desc:'The bean is still green and hard. No aroma to speak of yet — this is just raw seed.' },
    { pos:25, time:'4:30', color:'#c9a227', line:'#8a6c15', label:'Yellowing',
      title:'Hay and toast, drying out',
      desc:'Moisture is leaving the bean. It smells like fresh-cut hay and starts to smell faintly of bread.' },
    { pos:50, time:'8:00', color:'#a86a2e', line:'#7a4a1c', label:'First Crack',
      title:'Caramel, brown sugar, nutty',
      desc:'The bean audibly pops as steam escapes. This is where light roasts get pulled — bright acidity, origin flavor most intact.' },
    { pos:75, time:'10:30', color:'#7a4423', line:'#4d2a15', label:'Second Crack',
      title:'Cocoa, roasted nut, dark caramel',
      desc:'A quieter, sharper crack as the bean structure breaks down further. Origin character fades, roast character takes over.' },
    { pos:100, time:'13:00', color:'#2c1b12', line:'#150d08', label:'Charred',
      title:'Smoke, char, bitter ash',
      desc:'Past the point of no return — oils have surfaced and the sugars have burned. Nobody drinks this on purpose.' },
  ];

  function interpolate(a, b, t){
    const ah = a.match(/\w\w/g).map(x=>parseInt(x,16));
    const bh = b.match(/\w\w/g).map(x=>parseInt(x,16));
    const rh = ah.map((v,i)=>Math.round(v + (bh[i]-v)*t));
    return '#' + rh.map(v=>v.toString(16).padStart(2,'0')).join('');
  }

  function updateRoast(val){
    let lo = stops[0], hi = stops[stops.length-1];
    for(let i=0;i<stops.length-1;i++){
      if(val >= stops[i].pos && val <= stops[i+1].pos){ lo = stops[i]; hi = stops[i+1]; break; }
    }
    const span = hi.pos - lo.pos || 1;
    const t = (val - lo.pos) / span;
    const nearest = t < 0.5 ? lo : hi;

    beanFill.setAttribute('fill', interpolate(lo.color, hi.color, t));
    beanFill2.setAttribute('stroke', interpolate(lo.line, hi.line, t));
    stageLabel.textContent = nearest.label;
    stageLabel.style.color = nearest.color;
    stageTime.textContent = interpolateTime(lo, hi, t) + ' in the drum';
    flavorTitle.textContent = nearest.title;
    flavorTitle.style.color = nearest.color;
    flavorDesc.textContent = nearest.desc;
  }

  function interpolateTime(lo, hi, t){
    const toSec = s => { const [m,ss]=s.split(':').map(Number); return m*60+ss; };
    const total = Math.round(toSec(lo.time) + (toSec(hi.time)-toSec(lo.time))*t);
    const m = Math.floor(total/60), s = total%60;
    return m + ':' + String(s).padStart(2,'0');
  }

  slider.addEventListener('input', e => updateRoast(Number(e.target.value)));
  updateRoast(0);

  // Brew tabs
  const tabs = document.querySelectorAll('.tab-btn');
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.setAttribute('aria-selected','false'));
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      tab.setAttribute('aria-selected','true');
      document.getElementById(tab.getAttribute('aria-controls')).classList.add('active');
    });
  });

  // Contact form validation
  const form = document.getElementById('contactForm');
  const status = document.getElementById('formStatus');
  form.addEventListener('submit', e => {
    e.preventDefault();
    let valid = true;

    const name = document.getElementById('name');
    const email = document.getElementById('email');
    const message = document.getElementById('message');

    const setField = (id, ok) => {
      document.getElementById(id).classList.toggle('invalid', !ok);
      if(!ok) valid = false;
    };

    setField('field-name', name.value.trim().length > 0);
    setField('field-email', /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim()));
    setField('field-message', message.value.trim().length > 3);

    if(valid){
      status.textContent = "Thanks — we'll get back to you within a day.";
      status.className = 'form-status show ok';
      form.reset();
    } else {
      status.className = 'form-status';
    }
  });
</script>

</body>
</html>
